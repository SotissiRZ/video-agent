# =============================================================================
# Video Agent — configuration
# Copiez ce fichier en .env puis renseignez uniquement ce dont vous avez besoin.
# TOUT est optionnel : sans aucune clé, l'agent fonctionne en mode local/procédural
# (script généré par templates, animations Remotion, musique synthétisée).
# Ne commitez jamais votre fichier .env.
# =============================================================================

# --- LLM (concept + script) ---------------------------------------------------
# auto = premier fournisseur configuré (anthropic > openai > groq > openai-compatible),
# sinon procédural. Valeurs : auto | anthropic | openai | groq | openai-compatible | local
VIDEO_AGENT_LLM_PROVIDER=auto
VIDEO_AGENT_LLM_TIMEOUT_MS=120000
VIDEO_AGENT_LLM_TEMPERATURE=0.7

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tout serveur compatible OpenAI : Ollama, LM Studio, OpenRouter, Mistral, vLLM...
# Exemple Ollama : http://localhost:11434/v1 + OPENAI_COMPATIBLE_MODEL=llama3.1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --- Visuels : photos et vidéos réelles + images IA ----------------------------
# Pour chaque scène, l'agent essaie les sources dans cet ordre :
#   assets (vos fichiers dans ./assets) → stock (banques gratuites) → ai (génération IA)
VIDEO_AGENT_MEDIA_SOURCES=assets,stock,ai
# all = une photo/vidéo dans chaque scène | visual = scènes visuelles seulement | none
VIDEO_AGENT_MEDIA_COVERAGE=all

# Banques gratuites (clés gratuites) — vraies photos et clips libres de droits
# https://www.pexels.com/api/  ·  https://pixabay.com/api/docs/  ·  https://unsplash.com/developers
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# auto (toutes celles qui ont une clé) | none | liste ordonnée ex. pexels,pixabay
VIDEO_AGENT_STOCK_PROVIDERS=auto
# Utiliser aussi des clips vidéo (Pexels, Pixabay)
VIDEO_AGENT_STOCK_VIDEOS=true

# Génération d'images IA (utilisée quand rien n'est trouvé dans les banques)
# auto (replicate > stability > openai, selon les clés) | none | openai | replicate | stability
VIDEO_AGENT_IMAGE_PROVIDER=auto
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
STABILITY_API_KEY=
# core | ultra | sd3
STABILITY_MODEL=core
VIDEO_AGENT_MAX_GENERATED_IMAGES=4

# --- Voix-off (optionnel) -------------------------------------------------------
# auto (ElevenLabs puis OpenAI si une clé est présente) | none | openai | elevenlabs | system
# "system" = moteur du système (say sur macOS, SAPI sur Windows, espeak-ng sur Linux)
VIDEO_AGENT_VOICE_PROVIDER=auto
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voix système précise (ex. "Thomas" sur macOS, "fr" pour espeak)
VIDEO_AGENT_SYSTEM_VOICE=

# --- Génération de clips vidéo (optionnel, activé avec --ai-video) ----------------
# none | replicate
VIDEO_AGENT_VIDEO_PROVIDER=none
REPLICATE_VIDEO_MODEL=minimax/video-01
VIDEO_AGENT_MAX_GENERATED_CLIPS=2

# --- Musique ----------------------------------------------------------------------
# auto (piste de assets/music, sinon synthèse) | procedural | assets | none
VIDEO_AGENT_MUSIC=auto

# --- Valeurs par défaut -------------------------------------------------------------
VIDEO_AGENT_OUTPUT_DIR=output
VIDEO_AGENT_ASSETS_DIR=assets
# landscape | vertical | square | portrait | LARGEURxHAUTEUR
VIDEO_AGENT_DEFAULT_FORMAT=landscape
# Durée par défaut en secondes (vide = durée par défaut du template)
VIDEO_AGENT_DEFAULT_DURATION=
VIDEO_AGENT_DEFAULT_FPS=30
# mp4 | webm | mov | gif
VIDEO_AGENT_DEFAULT_OUTPUT_FORMAT=mp4
# auto | fr | en
VIDEO_AGENT_LANGUAGE=auto
VIDEO_AGENT_SUBTITLES=true

# --- Rendu ---------------------------------------------------------------------------
# Chemin d'un Chrome/Chromium headless. Vide = détection automatique
# (Chromium de Playwright s'il existe, sinon Remotion télécharge Chrome Headless Shell).
VIDEO_AGENT_BROWSER_EXECUTABLE=
# Nombre d'onglets de rendu en parallèle (vide = choix de Remotion)
VIDEO_AGENT_RENDER_CONCURRENCY=
VIDEO_AGENT_RENDER_TIMEOUT_MS=60000
# Qualité H.264/VP8 (plus bas = meilleure qualité). Vide = défaut Remotion
VIDEO_AGENT_CRF=

# --- Publication sur les réseaux sociaux -------------------------------------------------
# Assistant : video-agent auth <youtube|tiktok|linkedin|meta> --save   (voir README § Publication)
# Plateformes utilisées par --publish sans liste (ex. tiktok,instagram,youtube)
VIDEO_AGENT_PUBLISH_PLATFORMS=
# Créditer les photographes des banques d'images dans les descriptions YouTube/Facebook/LinkedIn
VIDEO_AGENT_CAPTION_CREDITS=true
# Planificateur des publications programmées intégré à "video-agent web"
VIDEO_AGENT_SCHEDULER=true

# YouTube (Google Cloud : API YouTube Data v3 + identifiant OAuth "Application de bureau")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY_ID=22

# TikTok (developers.tiktok.com : Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN=
# draft = brouillon dans l'app TikTok (sans audit) | direct = publication directe (audit TikTok requis pour le public)
TIKTOK_MODE=draft
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# Meta : Facebook (Page) + Instagram (compte professionnel lié à la Page)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Vide = FACEBOOK_PAGE_ACCESS_TOKEN
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn (developer.linkedin.com : "Share on LinkedIn" / "Community Management API")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
# urn:li:person:<id> (profil) ou urn:li:organization:<id> (page entreprise)
LINKEDIN_AUTHOR_URN=
# Version AAAAMM de l'API (vide = automatique)
LINKEDIN_API_VERSION=
# PUBLIC | CONNECTIONS
LINKEDIN_VISIBILITY=PUBLIC

# --- Interface web ---------------------------------------------------------------------
VIDEO_AGENT_HOST=127.0.0.1
VIDEO_AGENT_PORT=3210

# debug | info | warn | error | silent
VIDEO_AGENT_LOG_LEVEL=info
