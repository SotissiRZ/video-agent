# =============================================================================
# Video Agent — configuration
# Copiez ce fichier en .env puis renseignez uniquement ce dont vous avez besoin.
# TOUT est optionnel : sans aucune clé, l'agent fonctionne en mode local/procédural
# (script généré par templates, animations Remotion, musique synthétisée).
# Ne commitez jamais votre fichier .env.
# =============================================================================

# --- LLM (concept + script) ---------------------------------------------------
# auto = premier fournisseur configuré (anthropic > openai > groq > openai-compatible > ollama),
# sinon procédural. Valeurs : auto | anthropic | openai | groq | openai-compatible | ollama | local
# 💡 Gratuit : Groq (clé gratuite), Google Gemini via OPENAI_COMPATIBLE_*, ou Ollama (100 % local).
VIDEO_AGENT_LLM_PROVIDER=auto
VIDEO_AGENT_LLM_TIMEOUT_MS=120000
VIDEO_AGENT_LLM_TEMPERATURE=0.7

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tout serveur compatible OpenAI : Ollama, LM Studio, OpenRouter, Mistral, vLLM...
# Exemple Ollama : http://localhost:11434/v1 + OPENAI_COMPATIBLE_MODEL=llama3.1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Ollama : LLM local gratuit. Docker : COMPOSE_PROFILES=ollama + OLLAMA_BASE_URL=http://ollama:11434
# Hors Docker : installez https://ollama.com puis OLLAMA_BASE_URL=http://localhost:11434
# Le modèle est téléchargé automatiquement au premier usage.
#COMPOSE_PROFILES=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b

# --- Visuels : photos et vidéos réelles + images IA ----------------------------
# Pour chaque scène, l'agent essaie les sources dans cet ordre :
#   assets (vos fichiers dans ./assets) → stock (banques gratuites) → ai (génération IA)
VIDEO_AGENT_MEDIA_SOURCES=assets,stock,ai
# all = une photo/vidéo dans chaque scène | visual = scènes visuelles seulement | none
VIDEO_AGENT_MEDIA_COVERAGE=all

# Banques gratuites (clés gratuites) — vraies photos et clips libres de droits
# https://www.pexels.com/api/  ·  https://pixabay.com/api/docs/  ·  https://unsplash.com/developers
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# auto (toutes celles qui ont une clé) | none | liste ordonnée ex. pexels,pixabay
VIDEO_AGENT_STOCK_PROVIDERS=auto
# Utiliser aussi des clips vidéo (Pexels, Pixabay)
VIDEO_AGENT_STOCK_VIDEOS=true
# Visuels par scène : les scènes longues enchaînent jusqu'à N photos/clips (plans de 2 à 4 s). 1 = un seul.
VIDEO_AGENT_SHOTS_PER_SCENE=3

# Génération d'images IA (utilisée quand rien n'est trouvé dans les banques)
# auto (gratuits d'abord : cloudflare > huggingface, puis replicate > stability > openai)
# | none | cloudflare | huggingface | openai | replicate | stability
VIDEO_AGENT_IMAGE_PROVIDER=auto
# Gratuit : Cloudflare Workers AI (allocation quotidienne) — https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Gratuit : Hugging Face (crédits mensuels) — https://huggingface.co/settings/tokens
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
STABILITY_API_KEY=
# core | ultra | sd3
STABILITY_MODEL=core
VIDEO_AGENT_MAX_GENERATED_IMAGES=4

# --- Voix-off (optionnel) -------------------------------------------------------
# auto (ElevenLabs > OpenAI si clé, sinon Piper s'il est installé — toujours le cas dans Docker)
# | none | piper | openai | elevenlabs | system
# "piper"  = voix neuronales gratuites et locales (téléchargées automatiquement hors Docker)
# "system" = moteur du système (say sur macOS, SAPI sur Windows, espeak-ng sur Linux)
VIDEO_AGENT_VOICE_PROVIDER=auto
# Voix Piper : https://rhasspy.github.io/piper-samples/ (ex. fr_FR-tom-medium, en_US-ryan-medium)
PIPER_VOICE_FR=fr_FR-siwis-medium
PIPER_VOICE_EN=en_US-lessac-medium
# Débit : 1 = normal, 1.2 = plus lent
PIPER_LENGTH_SCALE=1
PIPER_DATA_DIR=.video-agent/piper
PIPER_BINARY=
PIPER_AUTO_DOWNLOAD=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Voix-off et génération de chansons ElevenLabs Music (offre payante)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voix système précise (ex. "Thomas" sur macOS, "fr" pour espeak)
VIDEO_AGENT_SYSTEM_VOICE=

# --- Génération de clips vidéo (optionnel, activé avec --ai-video) ----------------
# none | replicate
VIDEO_AGENT_VIDEO_PROVIDER=none
REPLICATE_VIDEO_MODEL=minimax/video-01
VIDEO_AGENT_MAX_GENERATED_CLIPS=2

# --- Musique ----------------------------------------------------------------------
# auto (piste de assets/music, sinon synthèse) | procedural | assets | none
VIDEO_AGENT_MUSIC=auto
# Musique composée par IA pour chaque vidéo (payant, quelques centimes par piste), repli sur la synthèse :
# none | auto | elevenlabs (ELEVENLABS_API_KEY) | stability (STABILITY_API_KEY) | replicate (REPLICATE_API_TOKEN, MusicGen)
VIDEO_AGENT_MUSIC_PROVIDER=none
REPLICATE_MUSIC_MODEL=meta/musicgen:671ac645ce5e552cc63a54a2bbff63fcf798043055d2dac5fc9e36a837eedcfb

# --- Valeurs par défaut -------------------------------------------------------------
VIDEO_AGENT_OUTPUT_DIR=output
VIDEO_AGENT_ASSETS_DIR=assets
# landscape | vertical | square | portrait | LARGEURxHAUTEUR
VIDEO_AGENT_DEFAULT_FORMAT=landscape
# Durée par défaut en secondes (vide = durée par défaut du template)
VIDEO_AGENT_DEFAULT_DURATION=
VIDEO_AGENT_DEFAULT_FPS=30
# mp4 | webm | mov | gif
VIDEO_AGENT_DEFAULT_OUTPUT_FORMAT=mp4
# auto | fr | en | ar | ary (darija) | sw | ha | yo | wo | bm | ln | pt
# Hors français/anglais, les textes sont écrits par le LLM ; voix : Piper (ar, sw, pt), OpenAI/ElevenLabs,
# ou Meta MMS via HF_TOKEN (wo, bm, ha, yo, ln — expérimental). « en wolof » dans la description suffit aussi.
VIDEO_AGENT_LANGUAGE=auto
VIDEO_AGENT_SUBTITLES=true

# --- Rendu ---------------------------------------------------------------------------
# Chemin d'un Chrome/Chromium headless. Vide = détection automatique
# (Chromium de Playwright s'il existe, sinon Remotion télécharge Chrome Headless Shell).
VIDEO_AGENT_BROWSER_EXECUTABLE=
# Nombre d'images rendues en parallèle (vide = moitié des cœurs). Jusqu'au nombre de cœurs = plus rapide.
VIDEO_AGENT_RENDER_CONCURRENCY=
# Vitesse d'encodage H.264 : ultrafast | superfast | veryfast | faster | fast | medium | slow | slower | veryslow
# (plus rapide = fichier un peu plus lourd)
VIDEO_AGENT_X264_PRESET=veryfast
# Moteur OpenGL de Chrome : auto (recommandé, ~3,5x plus rapide que swangle) | angle | swangle | swiftshader | egl | vulkan
VIDEO_AGENT_RENDER_GL=auto
VIDEO_AGENT_RENDER_TIMEOUT_MS=60000
# Qualité H.264/VP8 (plus bas = meilleure qualité). Vide = défaut Remotion
VIDEO_AGENT_CRF=

# --- Publication sur les réseaux sociaux -------------------------------------------------
# SaaS : seules les applications développeur (CLIENT_ID / SECRET, META_APP_*) sont nécessaires ;
# chaque client connecte ses comptes dans « Comptes connectés ». URL de retour à déclarer :
#   <PUBLIC_URL>/api/connections/<youtube|tiktok|linkedin|meta>/callback
# Ligne de commande (usage local) : video-agent auth <youtube|tiktok|linkedin|meta> --save
# Plateformes utilisées par --publish sans liste (ex. tiktok,instagram,youtube)
VIDEO_AGENT_PUBLISH_PLATFORMS=
# Créditer les photographes des banques d'images dans les descriptions YouTube/Facebook/LinkedIn
VIDEO_AGENT_CAPTION_CREDITS=true
# Planificateur des publications programmées intégré à "video-agent web"
VIDEO_AGENT_SCHEDULER=true

# YouTube (Google Cloud : API YouTube Data v3 + identifiant OAuth "Application de bureau")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY_ID=22

# TikTok (developers.tiktok.com : Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN=
# draft = brouillon dans l'app TikTok (sans audit) | direct = publication directe (audit TikTok requis pour le public)
TIKTOK_MODE=draft
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# Meta : Facebook (Page) + Instagram (compte professionnel lié à la Page)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Vide = FACEBOOK_PAGE_ACCESS_TOKEN
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn (developer.linkedin.com : "Share on LinkedIn" / "Community Management API")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
# urn:li:person:<id> (profil) ou urn:li:organization:<id> (page entreprise)
LINKEDIN_AUTHOR_URN=
# Version AAAAMM de l'API (vide = automatique)
LINKEDIN_API_VERSION=
# PUBLIC | CONNECTIONS
LINKEDIN_VISIBILITY=PUBLIC

# --- SaaS : comptes, base de données, paiement -------------------------------------------
# Production : docker-compose.prod.yml (HTTPS, PostgreSQL, workers). Voir README § SaaS.
# Domaine servi par Caddy (docker-compose.prod.yml) et mot de passe PostgreSQL.
#DOMAIN=app.example.com
#POSTGRES_PASSWORD=
# Nombre de workers de rendu (docker-compose.prod.yml)
#WORKERS=1
# PostgreSQL. Vide = base intégrée (PGlite) dans VIDEO_AGENT_DATA_DIR, idéale en local.
DATABASE_URL=
VIDEO_AGENT_DATA_DIR=.video-agent
# Secret de signature et de chiffrement des jetons (32 caractères min. : openssl rand -hex 32).
# Obligatoire avec PostgreSQL ; généré automatiquement avec la base intégrée.
APP_SECRET=
# URL publique (retours OAuth, Stripe, cookies sécurisés en https). Ex. https://app.example.com
PUBLIC_URL=
# open = inscriptions libres | closed = seuls les comptes existants (le premier compte est toujours admin)
SIGNUP_MODE=open
# E-mails administrateurs (séparés par des virgules)
ADMIN_EMAILS=
# Rendu dans le processus web : auto (oui avec la base intégrée) | true | false
VIDEO_AGENT_EMBEDDED_WORKER=auto
# Derrière un reverse proxy (Caddy) : faire confiance à X-Forwarded-For / X-Forwarded-Proto
VIDEO_AGENT_TRUST_PROXY=false

# Stripe (https://dashboard.stripe.com/apikeys). Webhook : <PUBLIC_URL>/api/stripe/webhook
# Événements : checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix mensuels (price_...) des offres Créateur et Pro
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
# E-mails (mot de passe oublié, vérification de l'adresse) : smtp(s)://utilisateur:motdepasse@hôte:port
# Exemples : smtps://user:pass@smtp-relay.brevo.com:465 · smtps://resend:re_xxx@smtp.resend.com:465
# Vide = les liens sont écrits dans les journaux du serveur (pratique en local).
SMTP_URL=
MAIL_FROM=Video Agent <no-reply@example.com>
# Exiger la confirmation de l'e-mail avant de créer des vidéos
REQUIRE_EMAIL_VERIFICATION=false
# Supprimer automatiquement les vidéos de plus de N jours (0 = conserver)
VIDEO_AGENT_RETENTION_DAYS=0
# Pages légales (conditions, confidentialité, mentions légales)
COMPANY_NAME=Video Agent
COMPANY_ADDRESS=
CONTACT_EMAIL=

# --- Paiements locaux : pass de 30 jours prépayés -------------------------------------
# GeniusPay (https://geniuspay.ci) : Wave, Orange Money, MTN, Moov, cartes — en FCFA (XOF).
# Clé pk_sandbox_… pour les tests, pk_live_… pour l'argent réel.
# Webhook à créer dans GeniusPay : <PUBLIC_URL>/api/payments/geniuspay/webhook (événement payment.success)
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
# YouCan Pay (https://youcanpay.com) : cartes, CashPlus — en dirhams (MAD).
# Webhook : <PUBLIC_URL>/api/payments/youcanpay/webhook (signé avec la clé privée)
YOUCANPAY_PRIVATE_KEY=
YOUCANPAY_SANDBOX=false
# Prix des pass de 30 jours (FCFA / dirhams)
PLAN_CREATOR_PRICE_XOF=10000
PLAN_PRO_PRICE_XOF=25000
PLAN_CREATOR_PRICE_MAD=190
PLAN_PRO_PRICE_MAD=490

# Prix affichés sur la page Tarifs
PLAN_CREATOR_PRICE=19 €
PLAN_PRO_PRICE=49 €

# --- Interface web ---------------------------------------------------------------------
# Page « Réglages » de l'interface (modifie ce fichier .env)
VIDEO_AGENT_SETTINGS_UI=true
VIDEO_AGENT_HOST=127.0.0.1
VIDEO_AGENT_PORT=3210
# Mot de passe facultatif devant tout le site (préproduction ; HTTP Basic, nom d'utilisateur libre).
VIDEO_AGENT_WEB_PASSWORD=

# debug | info | warn | error | silent
VIDEO_AGENT_LOG_LEVEL=info
